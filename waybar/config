{
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-bottom": 0,
    "margin-right": 0,

    "modules-left": ["custom/arch", "custom/theme-toggle", "sway/workspaces", "sway/window"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["backlight", "pulseaudio", "battery", "idle_inhibitor", "custom/power-profile", "bluetooth", "network", "sway/language", "tray"],

    "sway/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "󱓻",
            "default": "󱓼"
        }
    },

    "sway/window": {
        "rewrite": {
            "": "sway"
        }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "reverse-scrolling": true
    },

    "custom/arch": {
        "format": "󰣇 Arch",
        "tooltip": false
    },

    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩 {essid}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "Connnected through {ifname} ({signalStrength}%)",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "on-click": "networkmanager_dmenu"
    },

    "sway/language": {
        "format": "󰣩 {}"
    },

    "clock": {
        "interval": 5,
        "on-click": "gnome-calendar",
        "format": "󰥔 {:%H:%M 󰃭 %d-%m-%Y %a}"
    },

    "pulseaudio": {
        "format-icons": ["󰖀", "󰕾"],
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "reverse-scrolling": true
    },

    "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "tooltip-format": "{controller_alias} {controller_address}"
    },
    
    "custom/power-profile": {
    "exec": "powerprofilesctl get | grep -q 'power-saver' && echo '🍃' || echo '⚡'",
    "on-click": "powerprofilesctl get | grep -q 'power-saver' && powerprofilesctl set balanced || powerprofilesctl set power-saver",
    "interval": 2,
    "return-type": ""
    },

    "battery": {
        "states": {
          "warning": 30,
          "critical": 15
    },
        "interval": 10,
        "format-charging": "󰂄 {capacity}%",
        "format": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂂", "󰁹"]
    },
    
    "custom/weather": {
    "exec": "/home/hermes/.config/waybar/weather.sh",
    "interval": 600,
    "tooltip": false,
    "on-click": "gnome-weather"
    },

    "custom/theme-toggle": {
    "format": "{}",
    "exec": "gsettings get org.gnome.desktop.interface color-scheme | grep -q dark && echo '☀️' || echo '🌙'",
    "interval": 2,
    "on-click": "~/.config/waybar/toggle-theme.sh",
    "tooltip": false
    },

    "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
        "activated": "☕",
        "deactivated": "🖥️"
    }
}
}

