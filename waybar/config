{
    "height": 40,
    "margin-top": 0,
    "margin-left": 10,
    "margin-bottom": 0,
    "margin-right": 10,

    "modules-left": ["custom/arch", "sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["backlight", "pulseaudio", "battery", "custom/power-profile", "bluetooth", "network", "sway/language", "tray"],

    "sway/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "󱓻",
            "default": "󱓼"
        }
    },

    "sway/window": {
        "rewrite": {
            "": "sway"
        }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "reverse-scrolling": true
    },

    "custom/arch": {
        "format": "󰣇 Arch",
        "tooltip": false
    },

    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩 {essid}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "Connnected through {ifname} ({signalStrength}%)"
    },

    "sway/language": {
        "format": "󰣩 {}"
    },

    "clock": {
        "interval": 5,
        "format": "󰥔 {:%H:%M 󰃭 %a %Y-%m-%d}"
    },

    "pulseaudio": {
        "format-icons": ["󰖀", "󰕾"],
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "reverse-scrolling": true
    },

    "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "tooltip-format": "{controller_alias} {controller_address}"
    },
    
    "custom/power-profile": {
    "exec": "powerprofilesctl get | grep -q 'power-saver' && echo '🍃' || echo '⚡'",
    "on-click": "powerprofilesctl get | grep -q 'power-saver' && powerprofilesctl set balanced || powerprofilesctl set power-saver",
    "interval": 2,
    "return-type": ""
    },

    "battery": {
        "interval": 10,
        "format-charging": "󰂄 {capacity}%",
        "format": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂂", "󰁹"]
    }
}

